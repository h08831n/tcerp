# ==========================================
# TCERP Environment Configuration
# All passwords and private keys are placeholders.
# Do NOT commit real secrets to repository.
# ==========================================

# Application
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tcerp
DB_USER=erp_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=20

# Cache & Distributed Locking & BullMQ (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# Object Storage (MinIO / S3-compatible)
MINIO_ROOT_USER=erp_minio_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_PASSWORD
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=tcerp-files
S3_ACCESS_KEY=erp_minio_admin
S3_SECRET_KEY=REPLACE_WITH_MINIO_PASSWORD

# Authentication & JWT
JWT_ACCESS_SECRET=REPLACE_WITH_JWT_ACCESS_SECRET_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_JWT_REFRESH_SECRET_32_CHARS
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=REPLACE_WITH_COOKIE_SIGNING_SECRET

# Security & Encryption for Stored Secrets
SYSTEM_ENCRYPTION_KEY=REPLACE_WITH_AES256_HEX_KEY_64_CHARS

# External Integration Adapters (Mockable in Development)
SMS_PROVIDER=mock
SMS_API_KEY=PLACEHOLDER_SMS_KEY
SMS_LINE_NUMBER=PLACEHOLDER_LINE_NUMBER

MOADIAN_ENVIRONMENT=sandbox
MOADIAN_FISCAL_ID=PLACEHOLDER_FISCAL_MEMORY_ID
MOADIAN_PRIVATE_KEY=PLACEHOLDER_PRIVATE_KEY_PEM
MOADIAN_PUBLIC_CERT=PLACEHOLDER_PUBLIC_CERT_PEM

TELEGRAM_BOT_TOKEN=PLACEHOLDER_TELEGRAM_BOT_TOKEN
TELEGRAM_CHANNEL_ID=PLACEHOLDER_CHANNEL_ID
